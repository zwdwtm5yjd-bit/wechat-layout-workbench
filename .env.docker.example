# 复制为 .env.docker 后再替换所有 CHANGE_ME 值；也可由 pnpm docker:dev 自动生成。
COMPOSE_PROJECT_NAME=wechat-layout

WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

POSTGRES_DB=wechat_layout
POSTGRES_USER=wechat_layout
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=wechat_layout
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=wechat-layout-dev
