{
  "name": "wechat-layout-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "面向定稿文章的云端公众号智能视觉排版工作台",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "acceptance:seed": "node --import tsx infrastructure/scripts/acceptance-seed.ts",
    "dev": "turbo run dev",
    "docker:dev": "bash infrastructure/scripts/docker-dev.sh up",
    "docker:down": "bash infrastructure/scripts/docker-dev.sh down",
    "docker:logs": "bash infrastructure/scripts/docker-dev.sh logs",
    "docker:ps": "bash infrastructure/scripts/docker-dev.sh ps",
    "docker:config": "bash infrastructure/scripts/docker-dev.sh config",
    "docker:smoke": "bash infrastructure/scripts/docker-dev.sh smoke",
    "api:generate": "pnpm --filter @wechat-layout/web api:generate",
    "auth:bootstrap-owner": "pnpm --filter @wechat-layout/api auth:bootstrap-owner",
    "db:check": "pnpm --filter @wechat-layout/database db:check",
    "db:generate": "pnpm --filter @wechat-layout/database db:generate",
    "db:migrate": "pnpm --filter @wechat-layout/database db:migrate",
    "db:reset:test": "pnpm --filter @wechat-layout/database db:reset:test",
    "db:seed": "pnpm --filter @wechat-layout/database db:seed",
    "db:test:migrations": "bash infrastructure/scripts/database-migration-test.sh",
    "build": "turbo run build && pnpm build:python",
    "build:python": "PYTHONPATH=services/docx-worker-python/src python3 -m compileall -q services/docx-worker-python/src",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck && pnpm typecheck:infrastructure",
    "typecheck:infrastructure": "tsc --project infrastructure/tsconfig.json --noEmit",
    "test": "turbo run test && pnpm test:acceptance-seed && pnpm test:python",
    "test:acceptance-seed": "vitest run infrastructure/scripts/acceptance-seed-support.test.ts",
    "test:integration": "bash infrastructure/scripts/testcontainers-test.sh",
    "test:e2e": "playwright test",
    "test:python": "PYTHONPATH=services/docx-worker-python/src python3 -m unittest discover -s services/docx-worker-python/tests -p 'test_*.py'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.4",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vite": "8.0.13"
    }
  }
}
