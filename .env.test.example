# 测试环境示例：复制为 .env.test.local，并替换全部 CHANGE_ME。
APP_ENV=test
NODE_ENV=test
LOG_LEVEL=warn

NEXT_PUBLIC_APP_NAME=公众号智能视觉排版工具（测试）
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101
NEXT_PUBLIC_FEATURE_WECHAT_SYNC_ENABLED=false
NEXT_PUBLIC_FEATURE_REMOTE_COMPONENTS_ENABLED=false

PUBLIC_WEB_URL=http://localhost:3100
WEB_PORT=3100
API_PORT=3101
WORKER_CONCURRENCY=1
SCHEDULER_INTERVAL_SECONDS=60

DATABASE_URL=postgresql://wechat_layout_test:CHANGE_ME@localhost:5432/wechat_layout_test
SEED_OWNER_EMAIL=owner@example.invalid
SEED_OWNER_DISPLAY_NAME=Owner
SEED_OWNER_TIMEZONE=Asia/Shanghai
REDIS_URL=redis://:CHANGE_ME@localhost:6379/1

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ADDRESSING_STYLE=path
S3_PUBLIC_ADDRESSING_STYLE=path
S3_METADATA_HEADER_PREFIX=x-amz-meta-
S3_REGION=us-east-1
S3_BUCKET=wechat-layout-test
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

SMTP_HOST=localhost
SMTP_PORT=1025

SESSION_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME
ASSET_SIGNING_KEY=CHANGE_ME
BACKUP_ENCRYPTION_KEY=CHANGE_ME

FEATURE_WECHAT_SYNC_ENABLED=false
FEATURE_REMOTE_COMPONENTS_ENABLED=false
