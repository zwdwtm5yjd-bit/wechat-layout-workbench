# 开发环境示例：复制为 .env.local，并替换全部 CHANGE_ME；不要提交生成的文件。
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

NEXT_PUBLIC_APP_NAME=公众号智能视觉排版工具
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_FEATURE_WECHAT_SYNC_ENABLED=false
NEXT_PUBLIC_FEATURE_REMOTE_COMPONENTS_ENABLED=false

PUBLIC_WEB_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=3001
WORKER_CONCURRENCY=2
WEBPAGE_BROWSER_ENDPOINT=http://localhost:3010
WEBPAGE_FETCH_TIMEOUT_MS=15000
WEBPAGE_BROWSER_TIMEOUT_MS=30000
WEBPAGE_MAX_REDIRECTS=5
MAX_WEBPAGE_HTML_BYTES=5242880
SCHEDULER_INTERVAL_SECONDS=60

# 真实 AI 排版（可选）：不配置时只提供“快速规则排版”，不会伪装成 AI。
AI_LAYOUT_API_KEY=
AI_LAYOUT_BASE_URL=https://api.openai.com/v1
AI_LAYOUT_MODEL=gpt-5.6-sol
AI_LAYOUT_TIMEOUT_MS=90000

DATABASE_URL=postgresql://wechat_layout:CHANGE_ME@localhost:5432/wechat_layout
SEED_OWNER_EMAIL=owner@example.invalid
SEED_OWNER_DISPLAY_NAME=Owner
SEED_OWNER_TIMEZONE=Asia/Shanghai
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ADDRESSING_STYLE=path
S3_PUBLIC_ADDRESSING_STYLE=path
S3_METADATA_HEADER_PREFIX=x-amz-meta-
S3_REGION=us-east-1
S3_BUCKET=wechat-layout-development
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

SMTP_HOST=localhost
SMTP_PORT=1025

SESSION_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME
ASSET_SIGNING_KEY=CHANGE_ME
BACKUP_ENCRYPTION_KEY=CHANGE_ME

FEATURE_WECHAT_SYNC_ENABLED=false
FEATURE_REMOTE_COMPONENTS_ENABLED=false

MAX_JSON_BODY_BYTES=2097152
MAX_DOCX_FILE_BYTES=52428800
MAX_IMAGE_FILE_BYTES=20971520
MAX_BRAND_PACKAGE_BYTES=104857600
