[Unit]
Description=Wechat Layout encrypted PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wechat-layout/current
Environment=PRODUCTION_ENV_FILE=/etc/wechat-layout/production.env
ExecStart=/usr/local/bin/pnpm docker:prod:backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wechat-layout/backups /run/docker.sock
TimeoutStartSec=2h
UMask=0077

[Install]
WantedBy=multi-user.target
