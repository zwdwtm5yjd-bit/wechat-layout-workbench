# 生产环境示例：复制为 .env.production 后由 Secret/KMS/CI 注入真实值。
# 本文件只描述结构，全部 CHANGE_ME 都会被生产配置校验拒绝。
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

COMPOSE_PROJECT_NAME=wechat-layout-production
APP_DOMAIN=CHANGE_ME.example.com
IMAGE_REPOSITORY=CHANGE_ME.tencentcloudcr.com/wechat-layout
RELEASE_TAG=CHANGE_ME
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/CHANGE_ME.example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/CHANGE_ME.example.com/privkey.pem

NEXT_PUBLIC_APP_NAME=公众号智能视觉排版工具
NEXT_PUBLIC_APP_URL=https://CHANGE_ME.example.com
NEXT_PUBLIC_API_BASE_URL=https://CHANGE_ME.example.com
NEXT_PUBLIC_FEATURE_WECHAT_SYNC_ENABLED=false
NEXT_PUBLIC_FEATURE_REMOTE_COMPONENTS_ENABLED=false

PUBLIC_WEB_URL=https://CHANGE_ME.example.com
WEB_PORT=3000
API_PORT=3001
WORKER_CONCURRENCY=4
SCHEDULER_INTERVAL_SECONDS=60

POSTGRES_DB=wechat_layout
POSTGRES_USER=wechat_app
POSTGRES_PASSWORD=CHANGE_ME
# 若密码含 URL 保留字符，必须在 DATABASE_URL / REDIS_URL 中进行百分号编码。
DATABASE_URL=postgresql://wechat_app:CHANGE_ME@postgres:5432/wechat_layout

REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
S3_PUBLIC_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
S3_ADDRESSING_STYLE=virtual-hosted
S3_PUBLIC_ADDRESSING_STYLE=virtual-hosted
S3_METADATA_HEADER_PREFIX=x-cos-meta-
S3_REGION=ap-shanghai
S3_BUCKET=CHANGE_ME-production-1250000000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

SMTP_HOST=CHANGE_ME
SMTP_PORT=465

SESSION_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME
ASSET_SIGNING_KEY=CHANGE_ME
BACKUP_ENCRYPTION_KEY=CHANGE_ME

# 独立只写备份账号、私有 Bucket 和失败告警中继；不得复用应用 COS 密钥。
BACKUP_DIRECTORY=/var/lib/wechat-layout/backups
BACKUP_KEY_VERSION=backup-key-v1
BACKUP_LOCAL_RETENTION_COUNT=3
BACKUP_REMOTE_RETENTION_DAYS=30
BACKUP_RESTORE_MIN_ARTICLES=5
BACKUP_S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
BACKUP_S3_ADDRESSING_STYLE=virtual-hosted
BACKUP_S3_METADATA_HEADER_PREFIX=x-cos-meta-
BACKUP_S3_REGION=ap-shanghai
BACKUP_S3_BUCKET=CHANGE_ME-backups-1250000000
BACKUP_S3_PREFIX=production/postgresql
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_ALERT_WEBHOOK_URL=https://CHANGE_ME.example.com/hooks/database-backup

FEATURE_WECHAT_SYNC_ENABLED=false
FEATURE_REMOTE_COMPONENTS_ENABLED=false

MAX_JSON_BODY_BYTES=2097152
MAX_DOCX_FILE_BYTES=52428800
MAX_IMAGE_FILE_BYTES=20971520
MAX_BRAND_PACKAGE_BYTES=104857600
