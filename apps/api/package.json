{
  "name": "@wechat-layout/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @wechat-layout/config build && pnpm --filter @wechat-layout/database build && pnpm --filter @wechat-layout/storage-adapter build",
    "dev": "tsx watch src/main.ts",
    "auth:bootstrap-owner": "pnpm --filter @wechat-layout/database build && tsx src/auth/cli/bootstrap-owner.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@wechat-layout/config": "workspace:*",
    "@wechat-layout/database": "workspace:*",
    "@wechat-layout/document-schema": "workspace:*",
    "@wechat-layout/storage-adapter": "workspace:*",
    "@wechat-layout/wechat-renderer": "workspace:*",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "file-type": "21.3.4",
    "parse5": "8.0.1",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
