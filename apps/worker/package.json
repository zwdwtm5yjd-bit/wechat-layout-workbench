{
  "name": "@wechat-layout/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @wechat-layout/config build && pnpm --filter @wechat-layout/database build && pnpm --filter @wechat-layout/job-runtime build",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --passWithNoTests"
  },
  "dependencies": {
    "@wechat-layout/config": "workspace:*",
    "@wechat-layout/database": "workspace:*",
    "@wechat-layout/document-schema": "workspace:*",
    "@wechat-layout/job-runtime": "workspace:*",
    "@wechat-layout/storage-adapter": "workspace:*",
    "drizzle-orm": "0.45.2",
    "redis": "6.1.0"
  }
}
