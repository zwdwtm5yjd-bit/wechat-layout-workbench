{
  "name": "@wechat-layout/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @wechat-layout/config build",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm --filter @wechat-layout/config build",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "api:generate": "node scripts/generate-api-client.mjs",
